{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Build",
            "type": "shell",
            "command": "docker run --rm -u $(id -u):$(id -g) -v $(pwd):/workspace -w /workspace/build_arm luckfox-compiler:1.0 /bin/bash -c \"cmake -DCMAKE_TOOLCHAIN_FILE=/opt/luckfox-toolchain/toolchain.cmake .. && make\"",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Deploy and Start GDBServer",
            "type": "shell",
            "dependsOn": "CMake Build",
            "command": "scp ${config:embed.hostBuildPath} ${config:embed.targetUser}@${config:embed.targetIP}:${config:embed.targetPath} && ssh -t ${config:embed.targetUser}@${config:embed.targetIP} 'killall -q gdbserver; gdbserver :${config:embed.debugPort} ${config:embed.targetPath}'",
            "isBackground": true, 
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Listening on port"
                }
            }
        }
    ]
}